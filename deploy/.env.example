# Variables of deploy/compose.yml. Copy to deploy/.env (ignored by Git) and change the values.
# Everything below is an EXAMPLE: fine for trying the stack on your own machine, never for a
# server other people can reach.

# PostgreSQL of this stack (created empty on the first `up`). Use only letters, digits, "-" and
# "_" in the password: it goes inside a connection URL.
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=example-only-change-me
POSTGRES_DB=restaurant_saas

# Signing keys of the session tokens: at least 32 characters each, different from each other.
# Generate real ones with:  openssl rand -base64 48
JWT_ACCESS_SECRET=example-only-access-secret-change-me-0000
JWT_REFRESH_SECRET=example-only-refresh-secret-change-me-000

# Address people type in the browser to open the web (scheme + host + port, no trailing slash).
CORS_ORIGIN=http://localhost:3000

# Where API and web are published on this machine. 127.0.0.1 = only this machine.
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=4000

# Reverse proxies in front of the API whose X-Forwarded-For is trusted. Keep 0 here: the web
# container forwards no client address, so the API sees every browser as the web container
# (see deploy/README.md, "Limites conhecidos").
TRUST_PROXY_HOPS=0

# Logins and registrations accepted per minute from the same address. Through the web every
# browser counts as ONE address, so this is the limit for the whole restaurant together.
AUTH_RATE_LIMIT_PER_MINUTE=10

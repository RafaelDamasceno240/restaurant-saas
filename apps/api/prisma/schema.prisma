generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  INVITED
}

enum RoleName {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN
  DELIVERY
  VIEWER
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  legalName String
  document  String       @unique
  slug      String       @unique
  status    TenantStatus @default(TRIAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  branches          Branch[]
  users             User[]
  userRoles         UserRole[]
  auditLogs         AuditLog[]
  categories        Category[]
  products          Product[]
  orders            Order[]
  deliveries        Delivery[]
  cashSessions      CashRegisterSession[]
  cashMovements     CashMovement[]
  diningTables      DiningTable[]
  tabs              Tab[]
  payments          Payment[]
  inventoryItems    InventoryItem[]
  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  suppliers         Supplier[]
  customers         Customer[]
  coupons           Coupon[]
  couponRedemptions CouponRedemption[]
  purchases         Purchase[]
  purchaseSequence  PurchaseSequence?
  productRecipes    ProductRecipe[]
  inventoryCounts   InventoryCount[]

  @@map("tenants")
}

model Branch {
  id                 String       @id @default(uuid())
  tenantId           String
  name               String
  code               String
  document           String?
  phone              String?
  email              String?
  address            String?
  number             String?
  complement         String?
  neighborhood       String?
  city               String?
  state              String?
  zipCode            String?
  status             BranchStatus @default(ACTIVE)
  allowNegativeStock Boolean      @default(false)

  // Delivery settings (Fase 10). Defaults keep the behavior that existed before
  // the module: delivery accepted, no fee, no minimum.
  deliveryEnabled       Boolean @default(true)
  deliveryFeeCents      Int     @default(0)
  deliveryMinOrderCents Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userBranches      UserBranch[]
  orders            Order[]
  coupons           Coupon[]
  deliveries        Delivery[]
  cashSessions      CashRegisterSession[]
  diningTables      DiningTable[]
  tabs              Tab[]
  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  inventoryCounts   InventoryCount[]
  purchases         Purchase[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id           String     @id @default(uuid())
  tenantId     String
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles            UserRole[]
  userBranches         UserBranch[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  dispatchedDeliveries Delivery[]            @relation("DeliveryDispatchedBy")
  completedDeliveries  Delivery[]            @relation("DeliveryCompletedBy")
  courierDeliveries    Delivery[]            @relation("DeliveryCourier")
  openedCashSessions   CashRegisterSession[] @relation("CashSessionOpenedBy")
  closedCashSessions   CashRegisterSession[] @relation("CashSessionClosedBy")
  cashMovements        CashMovement[]
  stockMovements       StockMovement[]
  inventoryCounts      InventoryCount[]
  createdPurchases     Purchase[]            @relation("PurchaseCreatedBy")
  receivedPurchases    Purchase[]            @relation("PurchaseReceivedBy")
  cancelledPurchases   Purchase[]            @relation("PurchaseCancelledBy")

  @@index([tenantId])
  @@map("users")
}

model UserBranch {
  id        String   @id @default(uuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("user_branches")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  tenantId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@index([tenantId])
  @@map("user_roles")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  beforeData Json?
  afterData  Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Category {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  description  String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
  @@map("categories")
}

model Product {
  id           String   @id @default(uuid())
  tenantId     String
  categoryId   String
  name         String
  description  String?
  priceCents   Int
  imageUrl     String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  tabItems   TabItem[]
  recipe     ProductRecipe?

  @@index([tenantId])
  @@index([categoryId])
  @@map("products")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum OrderSource {
  ONLINE
  COUNTER
  TABLE
}

enum PaymentMethod {
  CASH
  PIX
  CARD
}

model Order {
  id              String          @id @default(uuid())
  tenantId        String
  branchId        String
  orderNumber     String          @unique
  status          OrderStatus     @default(PENDING)
  source          OrderSource     @default(ONLINE)
  // Snapshot of who ordered, exactly as typed at order time. Never rewritten by the CRM.
  customerName    String?
  customerPhone   String?
  // Optional link to the CRM customer (Fase 11). NULL for guest/public orders and for
  // every order that existed before the CRM. Independent of the snapshot above.
  customerId      String?
  fulfillmentType FulfillmentType
  paymentMethod   PaymentMethod
  notes           String?

  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?

  subtotalCents    Int
  // Discount applied to the ITEMS subtotal by a coupon (Fase 11, fatia 2); 0 without coupon.
  // Never applies to the delivery fee. CHECK: 0 <= discountCents <= subtotalCents.
  discountCents    Int     @default(0)
  // Snapshot of the delivery fee charged on this order (0 for non-delivery).
  // totalCents = subtotalCents - discountCents + deliveryFeeCents (CHECK in the database).
  deliveryFeeCents Int     @default(0)
  totalCents       Int
  // Coupon used, if any. couponCode is the canonical code AT ORDER TIME (snapshot, survives
  // the coupon being edited); couponId becomes NULL only if the coupon row ever disappears.
  couponId         String?
  couponCode       String?

  tabId          String? @unique
  idempotencyKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  tab          Tab?              @relation(fields: [tabId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  cashMovement CashMovement?
  payment      Payment?
  delivery     Delivery?
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon       Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  redemption   CouponRedemption?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@index([couponId])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String

  productId           String
  productNameSnapshot String
  unitPriceCents      Int
  quantity            Int
  subtotalCents       Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Operational state of a delivery, independent of the commercial OrderStatus.
// For a DELIVERY order only DeliveryService moves the order through
// READY -> OUT_FOR_DELIVERY -> DELIVERED, always in the same transaction.
// FAILED: an attempt did not reach the customer; the order goes back to READY
// (it is NOT cancelled) and the delivery can be re-requested (FAILED -> PENDING).
enum DeliveryStatus {
  PENDING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
}

// One row per DELIVERY order (1:1). The delivery address stays as the snapshot
// on the order; this table only carries the operational lifecycle.
model Delivery {
  id       String         @id @default(uuid())
  tenantId String
  branchId String
  orderId  String         @unique
  status   DeliveryStatus @default(PENDING)

  // Delivery-specific instructions ("Portão azul", "Interfone 204"). Independent of
  // Order.notes (the order's general observation). Max 300 chars (DB CHECK).
  notes String?

  // Number of dispatches so far (1 = first attempt). The full attempt history lives
  // in the audit log (DELIVERY_DISPATCHED / DELIVERY_FAILED / DELIVERY_REDELIVERY_REQUESTED).
  attemptCount Int @default(0)

  // Internal courier (a User with the DELIVERY role) responsible for this delivery.
  // Organizational only: it does not gate who may operate the delivery. Kept across
  // failure, redelivery, completion and cancellation; only assign/unassign change it
  // (and only while the delivery is alive). Who was assigned at each attempt is in the
  // audit log.
  courierUserId String?
  assignedAt    DateTime?

  dispatchedAt       DateTime?
  dispatchedByUserId String?
  deliveredAt        DateTime?
  completedByUserId  String?
  cancelledAt        DateTime?

  // Latest failure only; cleared when a redelivery is requested (history is audited).
  failedAt      DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dispatchedBy User?  @relation("DeliveryDispatchedBy", fields: [dispatchedByUserId], references: [id], onDelete: Restrict)
  completedBy  User?  @relation("DeliveryCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  courier      User?  @relation("DeliveryCourier", fields: [courierUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, branchId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, courierUserId])
  @@map("deliveries")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  WITHDRAWAL
  SUPPLY
  SALE
}

model CashRegisterSession {
  id                          String            @id @default(uuid())
  tenantId                    String
  branchId                    String
  openedByUserId              String
  closedByUserId              String?
  status                      CashSessionStatus @default(OPEN)
  openingBalanceCents         Int
  expectedClosingBalanceCents Int?
  countedClosingBalanceCents  Int?
  differenceCents             Int?
  openedAt                    DateTime          @default(now())
  closedAt                    DateTime?
  notes                       String?

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  openedBy  User           @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedBy  User?          @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  movements CashMovement[]

  @@index([tenantId, branchId, status])
  @@index([tenantId, openedAt])
  @@map("cash_register_sessions")
}

model CashMovement {
  id              String           @id @default(uuid())
  sessionId       String
  tenantId        String
  type            CashMovementType
  amountCents     Int
  reason          String?
  orderId         String?          @unique
  createdByUserId String
  createdAt       DateTime         @default(now())

  session   CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy User                @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
  @@map("cash_movements")
}

enum TabStatus {
  OPEN
  CLOSED
}

model DiningTable {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  number    Int
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tabs   Tab[]

  @@unique([branchId, number])
  @@index([tenantId])
  @@map("dining_tables")
}

model Tab {
  id           String    @id @default(uuid())
  tenantId     String
  branchId     String
  tableId      String
  status       TabStatus @default(OPEN)
  customerName String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table  DiningTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  items  TabItem[]
  order  Order?

  @@index([tenantId, branchId, status])
  @@index([tableId, status])
  @@map("tabs")
}

model TabItem {
  id                     String   @id @default(uuid())
  tenantId               String
  tabId                  String
  productId              String
  productNameSnapshot    String
  unitPriceCentsSnapshot Int
  quantity               Int
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tab     Tab     @relation(fields: [tabId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tabId])
  @@index([productId])
  @@map("tab_items")
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum PaymentProvider {
  INTERNAL
}

model Payment {
  id          String          @id @default(uuid())
  tenantId    String
  orderId     String          @unique
  method      PaymentMethod
  status      PaymentStatus
  provider    PaymentProvider @default(INTERNAL)
  amountCents Int
  externalId  String?
  confirmedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("payments")
}

enum InventoryUnit {
  UNIT
  KG
  G
  L
  ML
}

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  SALE
  REVERSAL
}

enum StockMovementOrigin {
  PURCHASE
  MANUAL
  ORDER
  INVENTORY
  REVERSAL
}

enum StockExitReason {
  CONSUMPTION
  LOSS
  DAMAGE
  ADJUSTMENT
  OTHER
}

enum StockReferenceType {
  ORDER
  INVENTORY_COUNT
  PURCHASE
}

model InventoryItem {
  id           String        @id @default(uuid())
  tenantId     String
  name         String
  sku          String?
  unit         InventoryUnit
  minStock     Decimal       @default(0) @db.Decimal(14, 3)
  maxStock     Decimal?      @db.Decimal(14, 3)
  tracksExpiry Boolean       @default(false)
  notes        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  balances      InventoryBalance[]
  movements     StockMovement[]
  recipeItems   ProductRecipeItem[]
  countItems    InventoryCountItem[]
  purchaseItems PurchaseItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("inventory_items")
}

model InventoryBalance {
  id               String   @id @default(uuid())
  tenantId         String
  branchId         String
  inventoryItemId  String
  quantity         Decimal  @default(0) @db.Decimal(14, 3)
  averageCostCents Int      @default(0)
  updatedAt        DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([branchId, inventoryItemId])
  @@index([tenantId, branchId])
  @@map("inventory_balances")
}

model StockMovement {
  id              String              @id @default(uuid())
  tenantId        String
  branchId        String
  inventoryItemId String
  type            StockMovementType
  origin          StockMovementOrigin
  quantity        Decimal             @db.Decimal(14, 3)
  balanceAfter    Decimal             @db.Decimal(14, 3)
  unitCostCents   Int?
  exitReason      StockExitReason?
  notes           String?
  supplierName    String?
  documentNumber  String?
  lotCode         String?
  expiresAt       DateTime?           @db.Date
  referenceType   StockReferenceType?
  referenceId     String?
  createdByUserId String?
  createdAt       DateTime            @default(now())

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdBy     User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  countItem     InventoryCountItem?

  @@unique([referenceType, referenceId, inventoryItemId, type])
  @@index([tenantId, branchId, createdAt])
  @@index([inventoryItemId, createdAt])
  @@index([branchId, inventoryItemId, expiresAt])
  @@map("stock_movements")
}

model ProductRecipe {
  id        String   @id @default(uuid())
  tenantId  String
  productId String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   ProductRecipeItem[]

  @@index([tenantId])
  @@map("product_recipes")
}

model ProductRecipeItem {
  id              String        @id @default(uuid())
  recipeId        String
  inventoryItemId String
  quantity        Decimal       @db.Decimal(14, 3)
  inputUnit       InventoryUnit

  recipe        ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([recipeId, inventoryItemId])
  @@map("product_recipe_items")
}

model InventoryCount {
  id              String   @id @default(uuid())
  tenantId        String
  branchId        String
  notes           String?
  createdByUserId String
  createdAt       DateTime @default(now())

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User                 @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  items     InventoryCountItem[]

  @@index([tenantId, branchId, createdAt])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id              String  @id @default(uuid())
  countId         String
  inventoryItemId String
  systemQuantity  Decimal @db.Decimal(14, 3)
  countedQuantity Decimal @db.Decimal(14, 3)
  difference      Decimal @db.Decimal(14, 3)
  stockMovementId String? @unique

  count         InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  stockMovement StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)

  @@unique([countId, inventoryItemId])
  @@map("inventory_count_items")
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  document  String?
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([tenantId, active])
  @@map("suppliers")
}

// CRM customer (Fase 11). Per TENANT: a customer can order in any branch.
// `phone` is stored as digits only and `cpf` as 11 digits (normalized in the
// application); `email` is lower-cased. Uniqueness lives in partial unique
// indexes created in SQL (not expressible here):
//   - (tenantId, phone) WHERE active            -> one ACTIVE customer per phone
//   - (tenantId, cpf)   WHERE cpf IS NOT NULL   -> a CPF identifies one person
// Customers are never deleted: they are deactivated, so order history keeps its link.
model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  phone     String
  email     String?
  cpf       String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders      Order[]
  redemptions CouponRedemption[]

  @@index([tenantId, active, name])
  @@map("customers")
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

// Promotional coupon (Fase 11, fatia 2). Every rule is evaluated by the backend; the client
// only ever sends the code. `code` is stored in its canonical form (trim + upper case, only
// A-Z 0-9 - _, 3 to 32 chars: CHECK in the database) and is immutable after creation.
// Uniqueness lives in a partial unique index created in SQL (not expressible here):
//   - (tenantId, code) WHERE active   -> never two ACTIVE coupons with the same code in a
//     tenant, while an old inactive one may share it.
// Coupons are never deleted: they are deactivated, so used coupons keep their history.
// value: PERCENTAGE = whole percent 1..100; FIXED = cents. All money is integer cents.
// usageCount is the number of ORDERS that consumed the coupon; it only changes inside the
// order transaction while the coupon row is locked FOR UPDATE (CHECK usageCount <= usageLimit
// is the last barrier). Cancelling an order does NOT give the usage back (known limitation).
model Coupon {
  id               String             @id @default(uuid())
  tenantId         String
  // NULL = valid at every branch of the tenant.
  branchId         String?
  code             String
  description      String?
  discountType     CouponDiscountType
  value            Int
  minOrderCents    Int                @default(0)
  // Only for PERCENTAGE: caps the discount in cents.
  maxDiscountCents Int?
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean            @default(true)
  usageLimit       Int?
  usageCount       Int                @default(0)
  // Needs a linked customer (PDV); a guest checkout can never use such a coupon.
  perCustomerLimit Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orders      Order[]
  redemptions CouponRedemption[]

  @@index([tenantId, active, createdAt])
  @@index([tenantId, code])
  @@map("coupons")
}

// One row per order that used a coupon: the usage trail and the source for the per-customer
// limit. orderId is unique (an order uses at most one coupon, and a retried transaction
// cannot record it twice).
model CouponRedemption {
  id            String   @id @default(uuid())
  tenantId      String
  couponId      String
  orderId       String   @unique
  customerId    String?
  discountCents Int
  createdAt     DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coupon   Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([couponId, customerId])
  @@index([tenantId, createdAt])
  @@map("coupon_redemptions")
}

model PurchaseSequence {
  tenantId   String @id
  lastNumber Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("purchase_sequences")
}

model Purchase {
  id              String         @id @default(uuid())
  tenantId        String
  branchId        String
  supplierId      String
  purchaseNumber  String
  status          PurchaseStatus @default(DRAFT)
  purchaseDate    DateTime       @db.Date
  subtotalCents   Int
  discountCents   Int            @default(0)
  freightCents    Int            @default(0)
  otherCostsCents Int            @default(0)
  totalCents      Int
  notes           String?
  createdById     String
  receivedAt      DateTime?
  receivedById    String?
  cancelledAt     DateTime?
  cancelledById   String?
  cancelReason    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier    Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  receivedBy  User?          @relation("PurchaseReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  cancelledBy User?          @relation("PurchaseCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  items       PurchaseItem[]

  @@unique([tenantId, purchaseNumber])
  @@index([tenantId, branchId, purchaseDate])
  @@index([tenantId, branchId, status])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id              String    @id @default(uuid())
  purchaseId      String
  inventoryItemId String
  quantity        Decimal   @db.Decimal(14, 3)
  unitCostCents   Int
  totalCostCents  Int
  lotCode         String?
  expiresAt       DateTime? @db.Date

  purchase      Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([inventoryItemId])
  @@map("purchase_items")
}

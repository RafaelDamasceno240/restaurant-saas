NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://saas:saas@localhost:5432/restaurant_saas?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000
AUTH_RATE_LIMIT_PER_MINUTE=10
# Proxies reversos na frente da API cujo X-Forwarded-For é confiável (0 = nenhum).
TRUST_PROXY_HOPS=0

# Endereço público do web: base dos links de checkout que o assistente do WhatsApp envia.
PUBLIC_WEB_URL=http://localhost:3000

# Assistente de WhatsApp (tudo opcional). Sem WHATSAPP_APP_SECRET o webhook recusa entregas;
# sem WHATSAPP_CLOUD_ENABLED=true nada é enviado à Cloud API (só números simulados).
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=v21.0
# 32 bytes em base64 (openssl rand -base64 32): cifra os tokens da Cloud API no banco.
# WHATSAPP_TOKEN_ENCRYPTION_KEY=
WHATSAPP_WORKER_ENABLED=true
# local = assistente por regras (sem custo). anthropic = Claude (exige ANTHROPIC_API_KEY).
WHATSAPP_AI_PROVIDER=local
WHATSAPP_AI_MODEL=claude-opus-5-5
WHATSAPP_AI_EFFORT=low
WHATSAPP_AI_MAX_TOKENS=2048
# ANTHROPIC_API_KEY=
